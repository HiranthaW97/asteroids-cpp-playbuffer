{
    // Press F5 to build the debug version and start the gdb debugger.
    // Set breakpoints by clicking left of a line number, then use:
    //   F5 continue · F10 step over · F11 step into · Shift+F11 step out
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Asteroids (gdb)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/Asteroids_debug.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "C:/msys64/ucrt64/bin/gdb.exe",
            "preLaunchTask": "Build Asteroids (debug)",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}
