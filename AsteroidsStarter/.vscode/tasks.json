{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Asteroids",
            "type": "shell",
            "command": "C:/msys64/ucrt64/bin/g++.exe",
            "args": [
                "-std=c++17",
                "-O2",
                "-mwindows",
                "-DUNICODE",
                "-D_UNICODE",
                "-Wno-multichar",
                "-static",
                "-static-libgcc",
                "-static-libstdc++",
                "Play.cpp",
                "MainGame.cpp",
                "Rigidbody.cpp",
                "Ship.cpp",
                "Asteroid.cpp",
                "-o",
                "Asteroids.exe",
                "-lgdiplus",
                "-ldwmapi",
                "-ldbghelp",
                "-lgdi32",
                "-lwinmm",
                "-lole32",
                "-lShlwapi",
                "-luuid",
                "-lxaudio2_8"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ],
            "detail": "Compile all .cpp files into Asteroids.exe with MSYS2 g++"
        },
        {
            "label": "Run Asteroids",
            "type": "shell",
            "command": "${workspaceFolder}/Asteroids.exe",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "Build Asteroids",
            "problemMatcher": []
        },
        {
            "label": "Build Asteroids (debug)",
            "type": "shell",
            "command": "C:/msys64/ucrt64/bin/g++.exe",
            "args": [
                "-std=c++17",
                "-g",
                "-O0",
                "-mwindows",
                "-DUNICODE",
                "-D_UNICODE",
                "-Wno-multichar",
                "-static", "-static-libgcc", "-static-libstdc++",
                "Play.cpp", "MainGame.cpp", "Rigidbody.cpp", "Ship.cpp", "Asteroid.cpp",
                "-o", "Asteroids_debug.exe",
                "-lgdiplus", "-ldwmapi", "-ldbghelp", "-lgdi32",
                "-lwinmm", "-lole32", "-lShlwapi", "-luuid", "-lxaudio2_8"
            ],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": ["$gcc"],
            "detail": "Debug build (-g -O0) with symbols, used by the F5 debugger."
        },
        {
            "type": "cppbuild",
            "label": "C/C++: g++.exe build active file",
            "command": "C:/msys64/ucrt64/bin/g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "C:/msys64/ucrt64/bin"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "detail": "Auto-generated single-file build. NOT used for this project (it can't compile Asteroids — no PlayBuffer libs). Use 'Build Asteroids' instead."
        }
    ]
}